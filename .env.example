# Copy this file to ".env" and fill it in — OR just use the app (Jackie.bat),
# which writes this file for you when you click Save. ".env" is gitignored.

# Which provider to use: claudecode | openrouter | gemini | groq | claude | zai | deepseek | qwen
JARVIS_PROVIDER=claudecode

# Paste the key for whichever provider you chose above.
# claudecode needs NO key (uses your local Claude Code login).
OPENROUTER_API_KEY=      # https://openrouter.ai/keys   (FREE)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys
ANTHROPIC_API_KEY=       # https://console.anthropic.com/settings/keys
ZAI_API_KEY=             # https://z.ai/manage-apikey/apikey-list   (GLM)
DEEPSEEK_API_KEY=        # https://platform.deepseek.com/api_keys
QWEN_API_KEY=            # https://bailian.console.alibabacloud.com/

# Hotkeys (global, handled by the background listener).
# Single letters fire while typing anywhere — combos don't. Examples: l, t,
# ctrl+alt+l, windows+j
# JARVIS_HOTKEY_OPEN=l             # opens Jackie — the ONLY thing that opens her
# JARVIS_HOTKEY_MIC=t              # background microphone off/on
# JARVIS_BOOT_OPEN=0               # 1 = also open the dashboard at every boot

# Optional overrides
# JARVIS_MODELS=claude-sonnet-5    # force a specific model (blank = provider default)
# JARVIS_BASE_URL=                 # custom OpenAI-compatible endpoint
# JARVIS_SPEAK=1                   # 0 = don't speak replies out loud
# JARVIS_STT_LANG=en-US            # speech language (blank in-app = auto)
# JARVIS_CLAP_THRESHOLD=0.01       # abs min clap peak — lower = more sensitive
# JARVIS_CLAP_RATIO=5              # spike = RATIO x the ambient noise floor
# JARVIS_INPUT_DEVICE=             # force a mic (index or part of its name)
# JARVIS_BROWSER=edge              # "default" = system default browser instead of Edge
# JARVIS_BLOCK_DANGEROUS=1         # 0 = allow destructive shell commands (max power)
# JARVIS_WORKSPACE=                # where Jackie writes generated files
